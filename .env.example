# ==========================================
# SMRITI CARE ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Google Gemini AI (Optional for Reminiscence Companion & Clinical AI)
GEMINI_API_KEY=

# 2. Supabase Authentication & PostgreSQL Database (Optional for Cloud Sync)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 3. Google Maps Platform (Optional for Live Online Google Maps & Places Search)
# Note: If omitted, Smriti Care automatically defaults to its offline-first
# open vector map dataset for North-Eastern India (OpenStreetMap / Natural Earth).
VITE_GOOGLE_MAPS_API_KEY=
