# ==============================================================================
# SMRITI CARE ENVIRONMENT CONFIGURATION
# ==============================================================================
# SECURITY NOTICE:
# 1. Variables starting with VITE_ are embedded into the client browser bundle.
#    NEVER place private AI keys, database master passwords, or admin tokens here.
# 2. Variables WITHOUT VITE_ are strictly read on the Node/Express backend (server.ts)
#    and will NEVER leak into client-side JavaScript.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE SECRETS (Backend Proxy Only - Never Exposed to Browser)
# ------------------------------------------------------------------------------
# Primary Google Gemini AI key for Reminiscence Companion & Clinical AI
GEMINI_API_KEY=

# Optional: Secondary fallback key to automatically rotate to if Primary hits 429 Rate Limits
GEMINI_API_KEY_FALLBACK=

# Optional: Server-side Google Maps key for backend geocoding/places proxies (Restricted by IP)
GOOGLE_MAPS_SERVER_KEY=

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE PUBLIC KEYS (Vite Embedded - Must Be Restricted in Provider Console)
# ------------------------------------------------------------------------------
# Google Maps JavaScript API key (Must have HTTP Referrer restrictions in Google Cloud Console!)
# Format: http://localhost:3000/*, https://yourdomain.com/*
VITE_GOOGLE_MAPS_API_KEY=

# Supabase Authentication & PostgreSQL Database (Protected by Postgres Row Level Security)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

