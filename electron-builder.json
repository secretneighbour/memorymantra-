{
  "appId": "com.smriticare.app",
  "productName": "Memory Mantra",
  "copyright": "Copyright © 2026 Memory Mantra / NEURO NER",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "toolsets": {
    "nsis": "1.2.1"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "public/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico",
    "signAndEditExecutable": false,
    "signExecutable": false,
    "artifactName": "Memory-Mantra-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "packElevateHelper": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Memory Mantra",
    "uninstallDisplayName": "Memory Mantra"
  }
}
